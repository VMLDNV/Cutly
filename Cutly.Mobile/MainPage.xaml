<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cutly.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#080808"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <Grid SafeAreaEdges="None">

        <!-- Снимка на целия екран -->
        <Image
            Source="barber_welcome.jpg"
            Aspect="AspectFill" />

        <!-- Тъмно покритие върху снимката -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">
                    <GradientStop
                        Color="#55000000"
                        Offset="0.0" />
                    <GradientStop
                        Color="#99000000"
                        Offset="0.45" />
                    <GradientStop
                        Color="#F5000000"
                        Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Съдържание върху снимката -->
        <Grid
            Padding="28,24,28,35"
            RowDefinitions="Auto,*,Auto"
            SafeAreaEdges="None">

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="6"
                Margin="0,20,0,0">

                <Label
                    Text="CUTLY"
                    FontSize="38"
                    FontAttributes="Bold"
                    CharacterSpacing="5"
                    TextColor="White"
                    HorizontalOptions="Center" />

                <Label
                    Text="ТВОЯТ СТИЛ. ТВОЯТ ЧАС."
                    FontSize="11"
                    CharacterSpacing="2"
                    TextColor="#E0E0E0"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="2"
                Spacing="0">

                <Label
                    Text="Твоят следващ стил."
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center" />

                <Label
                    Text="Намери своя бръснар. Запази своя час."
                    FontSize="14"
                    TextColor="#D0D0D0"
                    HorizontalTextAlignment="Center"
                    Margin="0,10,0,28" />

                <Button
                    x:Name="CustomerButton"
                    Text="Продължи като клиент"
                    Clicked="OnCustomerClicked"
                    HeightRequest="56"
                    CornerRadius="28"
                    BackgroundColor="White"
                    TextColor="#111111"
                    FontSize="15"
                    FontAttributes="Bold" />

                <Button
                    x:Name="BarberButton"
                    Text="Продължи като бръснар"
                    Clicked="OnBarberClicked"
                    HeightRequest="56"
                    CornerRadius="28"
                    BackgroundColor="#252525"
                    TextColor="White"
                    BorderColor="#777777"
                    BorderWidth="1"
                    FontSize="15"
                    Margin="0,12,0,0" />

                <Label
                    Text="С CUTLY СТИЛЪТ ЗАПОЧВА ТУК"
                    FontSize="9"
                    CharacterSpacing="1.5"
                    TextColor="#A0A0A0"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Margin="0,25,0,0" />

            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
