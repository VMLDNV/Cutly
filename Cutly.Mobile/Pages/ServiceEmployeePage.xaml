<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cutly.Mobile.Pages.ServiceEmployeesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#080808"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,18"
            Spacing="15">

            <Grid ColumnDefinitions="50,*">

                <Button
                    Text="‹"
                    FontSize="30"
                    TextColor="White"
                    BackgroundColor="#202020"
                    WidthRequest="46"
                    HeightRequest="46"
                    CornerRadius="23"
                    Clicked="OnBackClicked" />

                <Label
                    Grid.Column="1"
                    Text="Избери бръснар"
                    FontSize="23"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center"
                    Margin="12,0" />

            </Grid>

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="Избрана услуга"
                    FontSize="12"
                    CharacterSpacing="1.5"
                    TextColor="#999999" />

                <Label
                    x:Name="ServiceNameLabel"
                    Text="Мъжко подстригване"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#F5C542" />

                <Label
                    Text="Избери служител и виж неговата цена."
                    FontSize="13"
                    TextColor="#AAAAAA" />

            </VerticalStackLayout>

            <BoxView
                HeightRequest="1"
                BackgroundColor="#333333" />

        </VerticalStackLayout>

        <!-- Employees -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                x:Name="EmployeesContainer"
                Padding="20,5,20,25"
                Spacing="14" />

        </ScrollView>

    </Grid>
</ContentPage>
