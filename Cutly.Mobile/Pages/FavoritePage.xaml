<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cutly.Mobile.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#080808"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="20,30,20,24"
                Spacing="22">

                <Grid ColumnDefinitions="Auto,*">

                    <Button
                        Text="‹"
                        FontSize="30"
                        TextColor="White"
                        BackgroundColor="#1B1B1B"
                        WidthRequest="45"
                        HeightRequest="45"
                        CornerRadius="22"
                        Clicked="OnBackClicked" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Padding="12,0"
                        VerticalOptions="Center"
                        Spacing="3">

                        <Label
                            Text="Любими салони"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Твоите запазени места"
                            FontSize="12"
                            TextColor="#999999" />

                    </VerticalStackLayout>

                </Grid>

                <Label
                    x:Name="EmptyStateLabel"
                    Text="Все още нямаш любими салони.&#10;Добави салон чрез сърцето ❤️"
                    FontSize="14"
                    TextColor="#AAAAAA"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center"
                    IsVisible="False"
                    Margin="0,60,0,0" />

                <VerticalStackLayout
                    x:Name="FavoritesContainer"
                    Spacing="14" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
