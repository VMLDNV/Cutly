<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cutly.Mobile.Pages.SalonDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#080808"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Salon image and back button -->
                <Grid HeightRequest="280">

                    <Image
                        x:Name="SalonImage"
                        Source="barber_welcome.jpg"
                        Aspect="AspectFill" />

                    <BoxView
                        BackgroundColor="#55000000" />

                    <Button
                        Text="‹"
                        FontSize="32"
                        TextColor="White"
                        BackgroundColor="#66000000"
                        WidthRequest="48"
                        HeightRequest="48"
                        CornerRadius="24"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="18"
                        Clicked="OnBackClicked" />

                </Grid>

                <VerticalStackLayout
                    Padding="20"
                    Spacing="18">

                    <!-- Salon information -->
                    <VerticalStackLayout Spacing="8">

                        <Label
                            x:Name="SalonNameLabel"
                            Text="Име на салона"
                            FontSize="27"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            x:Name="RatingLabel"
                            Text="Все още няма оценки"
                            FontSize="14"
                            TextColor="#F5C542" />

                        <Label
                            x:Name="AddressLabel"
                            Text="Адрес"
                            FontSize="14"
                            TextColor="#BBBBBB" />

                        <Label
                            x:Name="PhoneLabel"
                            FontSize="14"
                            TextColor="#BBBBBB" />

                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#333333" />

                    <!-- Description -->
                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="За салона"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            x:Name="DescriptionLabel"
                            FontSize="14"
                            TextColor="#BBBBBB"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#333333" />

                    <!-- Employees -->
                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Нашият екип"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <VerticalStackLayout
                            x:Name="EmployeesContainer"
                            Spacing="14" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom button -->
        <Border
            Grid.Row="1"
            BackgroundColor="#111111"
            Padding="20,12"
            Stroke="#292929">

            <Button
                Text="Запази час"
                BackgroundColor="#F2F2F2"
                TextColor="#111111"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="54"
                Clicked="OnBookAppointmentClicked" />

        </Border>

    </Grid>
</ContentPage>
