<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Cutly.Mobile.Pages.MySchedulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#080808"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Padding="20,20,20,15"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12">

            <!-- Back Button -->
            <Button Text="‹"
                    FontSize="34"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Padding="0"
                    WidthRequest="40"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    Clicked="OnBackClicked"/>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="5"
                                 VerticalOptions="Center">

                <Label Text="МОЯТ ГРАФИК"
                       FontSize="21"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Label x:Name="MonthLabel"
                       Text="Ноември 2026"
                       FontSize="23"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,10,0,5"/>

            </VerticalStackLayout>
        </Grid>

        <!-- Weekly calendar -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">

            <HorizontalStackLayout
                x:Name="WeekDaysContainer"
                Padding="12,0,12,15"
                Spacing="5"/>

        </ScrollView>

        <!-- Selected day appointments -->
        <ScrollView Grid.Row="2">

            <VerticalStackLayout Padding="12,10,12,25"
                                 Spacing="14">

                <BoxView HeightRequest="1"
                         Color="#242424"
                         Margin="0,0,0,10"/>

                <!-- Selected date and working hours -->
                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">

                    <Label x:Name="SelectedDateLabel"
                           Text="Сряда, 04 ноември"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"/>

                    <Label x:Name="WorkingHoursLabel"
                           Grid.Column="1"
                           Text="Работно време"
                           FontSize="12"
                           TextColor="#00C853"
                           BackgroundColor="#10291B"
                           Padding="9,5"
                           VerticalOptions="Center"/>

                </Grid>

                <!-- Appointments heading -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,5,0,0">

                    <Label Text="Резервации"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label x:Name="AppointmentCountLabel"
                           Grid.Column="1"
                           Text="0 часа"
                           FontSize="12"
                           TextColor="#CCCCCC"
                           VerticalOptions="Center"/>

                </Grid>

                <!-- Loading -->
                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    Color="#C30F45"/>

                <!-- Empty state -->
                <Label x:Name="EmptyLabel"
                       Text="Няма резервации за този ден."
                       TextColor="#999999"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,30,0,0"
                       IsVisible="False"/>

                <!-- Appointments list -->
                <VerticalStackLayout
                    x:Name="AppointmentsContainer"
                    Spacing="12"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
